generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// New enums for richer review data
enum Fit {
  SMALL
  TRUE_TO_SIZE
  BIG
}

enum Cushion {
  SOFT
  BALANCED
  FIRM
}

enum Stability {
  NEUTRAL
  MODERATE_SUPPORT
  HIGH_SUPPORT
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  weight    Int?
  pace      Float?
  reviews   Review[]
  reviewVotes ReviewVote[]
  createdAt DateTime  @default(now())
}

model Shoe {
  id           Int       @id @default(autoincrement())
  brand        String
  model        String
  type         String       // e.g., easy, tempo, long run
  stackHeight  Float?       // mm
  drop         Float?       // heel-toe drop in mm
  weightGrams  Float?       // optional shoe weight in grams
  releaseYear  Int?
  category     String?      // neutral / stability / trail
  imageUrl     String?
  reviews      Review[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt @default(now())
}

model Review {
  id         Int       @id @default(autoincrement())
  rating     Int
  comment    String
  shoe       Shoe      @relation(fields: [shoeId], references: [id])
  shoeId     Int
  user       User      @relation(fields: [userId], references: [id])
  userId     Int
  votes      ReviewVote[]
  // legacy aggregate pace in min/km or min/mi
  pace       Float?
  // new structured fields
  fit        Fit?
  cushion    Cushion?
  stability  Stability?
  mileage    Int?        // total miles/kilometers logged on the shoe
  paceMinutes Int?        // legacy - single pace value
  paceSeconds Int?        // legacy - single pace value
  weight     Int?         // legacy - single weight value
  paceRange  String?      // pace range identifier (e.g., "pace-mile-9-31-to-10-59")
  weightRange String?     // weight range identifier (e.g., "weight-lbs-150-170")
  createdAt  DateTime  @default(now())
}

model ReviewVote {
  id        Int      @id @default(autoincrement())
  review    Review   @relation(fields: [reviewId], references: [id])
  reviewId  Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  value     Int
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}
